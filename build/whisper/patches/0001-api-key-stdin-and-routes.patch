+// AIOS: compare without stopping at the first differing byte.
+static bool same_key(const std::string & a, const std::string & b) {
+    if (a.size() != b.size()) {
+        return false;
+    }
+    unsigned char diff = 0;
+    for (size_t i = 0; i < a.size(); i++) {
+        diff |= (unsigned char) (a[i] ^ b[i]);
+    }
+    return diff == 0;
+}
