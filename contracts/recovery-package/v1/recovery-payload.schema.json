{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tryaios.com/contracts/recovery-package/v1/recovery-payload",
  "title": "recovery-package/v1/recovery-payload",
  "description": "Decrypted payload of recovery.pkg (JCS bytes are the AES-256-GCM plaintext). Exists only in memory.",
  "x-status": "draft",
  "type": "object",
  "required": ["v", "db_key", "signing_key_seed", "stream_id"],
  "properties": {
    "v": { "const": 1 },
    "db_key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$", "description": "32-byte SQLCipher raw key, base64url without padding" },
    "signing_key_seed": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$", "description": "32-byte Ed25519 seed (RFC 8032), base64url without padding" },
    "stream_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" }
  }
}
