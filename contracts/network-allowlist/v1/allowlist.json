{
  "$schema": "./allowlist.schema.json",
  "version": 1,
  "flows": [
    {
      "id": "model-mirror",
      "host": "models.example.eu",
      "port": 443,
      "scheme": "https",
      "client": "backend-net",
      "when": "first run, user install"
    },
    {
      "id": "update-feed",
      "host": "updates.example.eu",
      "port": 443,
      "scheme": "https",
      "client": "electron-updater",
