{
  "components": {
    "schemas": {
      "ComponentState": {
        "enum": [
          "not_started",
          "starting",
          "ok",
          "degraded",
          "failed"
        ],
        "title": "ComponentState",
        "type": "string"
      },
      "Health": {
        "properties": {
          "backend": {
            "title": "Backend",
            "type": "string"
          },
          "database": {
            "title": "Database",
            "type": "string"
          },
          "engine": {
            "$ref": "#/components/schemas/ComponentState"
          },
          "evidence_writer": {
            "$ref": "#/components/schemas/ComponentState"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "backend",
          "database",
          "engine",
          "evidence_writer",
          "version"
        ],
        "title": "Health",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "AIOS Local API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Backend, database, engine and evidence writer status",
        "tags": [
          "system"
        ]
      }
    }
  }
}
